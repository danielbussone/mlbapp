# API (apps/api) — copy to repo root .env for local dev
PORT=3001
# If another checkout (e.g. a `_bak` folder) or Docker already listens on PORT, either stop that
# process or pick a free port here and set VITE_API_PROXY_TARGET to match (Vite reads repo-root .env).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3002
# Compose maps Postgres to host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql://mlbapp:mlbapp@localhost:5433/mlbapp
OLLAMA_HOST=http://localhost:11434
# Model must support Ollama tool calling (e.g. llama3.2, qwen2.5, mistral). Pull: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
# Context size for /api/chat (large compare payloads need headroom). Default 32768.
# OLLAMA_NUM_CTX=32768
# Undici timeouts for Ollama HTTP (ms). Defaults 1800000 (30m); large num_ctx + compare JSON can exceed 15m on CPU.
# OLLAMA_FETCH_HEADERS_TIMEOUT_MS=1800000
# OLLAMA_FETCH_BODY_TIMEOUT_MS=1800000
# OLLAMA_FETCH_CONNECT_TIMEOUT_MS=15000
# Optional: log full tool args + tool result JSON (chars capped). Default 0 = log sizes/names/keys only.
# CHAT_LOG_TOOL_BODY_MAX=8192
#
# Chat observability (structured logs on POST /chat, reqId-scoped):
# — Postgres: logs step=db_query per query while handling /chat (sqlPreview, rowCount, durationMs). Set CHAT_LOG_DB=off to disable.
# CHAT_LOG_DB=off
# Optional bound params (max N params, each preview clipped): CHAT_LOG_DB_PARAMS_MAX=20
# Optional first N result rows as JSON previews: CHAT_LOG_DB_ROWS=2
# — Ollama "what the model sees": transcriptJsonChars + messages[] on each step=ollama_request.
# CHAT_LOG_LLM_TOOL_CHARS=4096   # per role=tool message contentPreview (0 = omit; default 4096)
# CHAT_LOG_LLM_SYSTEM_CHARS=0   # system prompt preview (0 = omit only length)
# CHAT_LOG_LLM_ASSISTANT_CHARS=8000  # full model reply in step=ollama_response (0 = default omit)
#
# Full tool input/output on disk (not SSE-truncated). One JSON file per tool call; correlates with reqId in filename.
# CHAT_TOOL_TRACE_DIR=logs/chat-tool-traces
# Per Ollama /api/chat round: log step=ollama_performance (wall clock + eval counts/durations). off|0 to disable.
# CHAT_LOG_OLLAMA_PERF=off
# Log Node process RSS/heap at start and end of each /api/chat stream (1|true|on). Not Ollama's RAM — see GET /health/ollama.
# CHAT_LOG_PROCESS_MEMORY=on

# API inside Docker Compose uses service hostname:
# OLLAMA_HOST=http://ollama:11434

# FanGraphs ETL (optional): if leaders return HTTP 403, try HTTPS_PROXY or paste a
# browser Cookie header from DevTools (advanced): MLBAPP_FG_COOKIE=...
# Seconds to sleep between FanGraphs HTTP calls (pagination + bat→pit + season chunks). Default 10; use 0 to disable.
# MLBAPP_FG_THROTTLE_SECONDS=10
# Wide season ranges are split into this many years per request (FanGraphs often HTTP 500 on huge spans). Default 10; 0 = one request for full range.
# MLBAPP_FG_SEASON_CHUNK_YEARS=10

# Chadwick register ETL (`pnpm etl:chadwick`): optional local zip instead of GitHub download.
# MLBAPP_CHADWICK_REGISTER_ZIP_FILE=/path/to/register.zip
# MLBAPP_CHADWICK_REGISTER_ZIP_URL=https://github.com/chadwickbureau/register/archive/refs/heads/master.zip
# MLBAPP_CHADWICK_CHUNK_SIZE=2000

# Statcast ETL (`pnpm etl:statcast`): league mode chunks + politeness + retries.
# MLBAPP_STATCAST_CHUNK_DAYS=1
# MLBAPP_STATCAST_THROTTLE_SECONDS=0.75
# MLBAPP_STATCAST_MAX_RETRIES=4
# Default season window when using --season Y (MMDD strings).
# MLBAPP_STATCAST_SEASON_START_MMDD=03-01
# MLBAPP_STATCAST_SEASON_END_MMDD=11-30
